<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.cropnexa.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.cropnexa.app.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
    
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.cropnexa.app.ui.auth.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.cropnexa.app.ui.dashboard.DashboardFragment"
        android:label="Home"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.cropnexa.app.ui.weather.WeatherFragment"
        android:label="Weather"
        tools:layout="@layout/fragment_weather" />

    <fragment
        android:id="@+id/cropsFragment"
        android:name="com.cropnexa.app.ui.dashboard.CropsFragment"
        android:label="Crops"
        tools:layout="@layout/fragment_crops" >
        <action
            android:id="@+id/action_cropsFragment_to_cropDetailFragment"
            app:destination="@id/cropDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/soilFragment"
        android:name="com.cropnexa.app.ui.dashboard.SoilFragment"
        android:label="Soil"
        tools:layout="@layout/fragment_soil" />

    <fragment
        android:id="@+id/cropDetailFragment"
        android:name="com.cropnexa.app.ui.dashboard.CropDetailFragment"
        android:label="Crop Details"
        tools:layout="@layout/fragment_crop_detail" >
        <argument
            android:name="cropName"
            app:argType="string" />
        <argument
            android:name="cropCategory"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.cropnexa.app.ui.dashboard.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/nutrientFragment"
        android:name="com.cropnexa.app.ui.dashboard.NutrientFragment"
        android:label="Nutrient Advice"
        tools:layout="@layout/fragment_nutrient" />

    <fragment
        android:id="@+id/insightsFragment"
        android:name="com.cropnexa.app.ui.dashboard.InsightsFragment"
        android:label="Insights"
        tools:layout="@layout/fragment_insights" />

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.cropnexa.app.ui.dashboard.ReportsFragment"
        android:label="Reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cropnexa.app.ui.dashboard.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/companionFragment"
        android:name="com.cropnexa.app.ui.dashboard.CompanionFragment"
        android:label="Companion Planner"
        tools:layout="@layout/fragment_companion" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.cropnexa.app.ui.dashboard.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.cropnexa.app.ui.dashboard.AdminFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin" />

</navigation>
