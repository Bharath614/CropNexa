<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="AI Insights"
            app:titleTextColor="@color/colorTextPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Yield Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:strokeColor="#064e3b"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YIELD PREDICTION"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvYield"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.8 t/ha"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTotalYield"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total harvest projection: 190.0 tonnes"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Revenue Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:strokeColor="#064e3b"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPECTED GROSS REVENUE"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹4,864,000"
                        android:textColor="#34d399"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvPremium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Organic premiums: Disabled"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Companion Impact Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:strokeColor="#064e3b"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPANION IMPACT RATING"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvCompanionImpact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88%"
                        android:textColor="#fbbf24"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optimal ecological stability rating"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Water Chart -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WATER RECOMMENDATION (kL)"
                android:textColor="@color/colorTextMuted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/waterLineChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rain Yield represents natural precipitation capture equivalent based on rain forecasts. Gap must be supplied via irrigation."
                android:textColor="@color/colorTextMuted"
                android:textSize="9sp"
                android:layout_marginBottom="16dp"/>

            <!-- Risk Assessment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIOLOGICAL RISK ASSESSMENT"
                android:textColor="@color/colorTextMuted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ProgressBar
                        android:id="@+id/pestRiskProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:progressDrawable="@drawable/bg_nutrient_progress"
                        android:max="100"
                        android:progress="65" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pest Risk"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ProgressBar
                        android:id="@+id/diseaseRiskProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:progressDrawable="@drawable/bg_nutrient_progress"
                        android:max="100"
                        android:progress="45" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disease Risk"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/colorBackground"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEATHER IMPACT"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvWeatherImpact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elevated humidity levels combined with temperature spikes stimulate pest propagation cycles. Keep companion traps in place."
                    android:textColor="@color/colorTextMuted"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Nutrient Recommendation Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#022c22"
                app:cardCornerRadius="16dp"
                app:strokeColor="#065f46"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUTRIENT RECOMMENDATION"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on soil chemistry profiles, a Nitrogen deficit is expected in 14 days unless organic topdressing is applied."
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"/>
                    <Button
                        android:id="@+id/btnOpenNutrientGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPEN NUTRIENT GUIDE"
                        android:textSize="10sp"
                        android:textColor="#34d399"
                        android:backgroundTint="#064e3b" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
