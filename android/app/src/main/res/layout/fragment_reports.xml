<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0f172a"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Reports Engine"
            app:titleTextColor="#f8fafc"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRepFarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#064e3b"
                    android:text="Farm"
                    android:textColor="#34d399"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRepSoil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#1e293b"
                    android:text="Soil"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRepWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#1e293b"
                    android:text="Weather"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRepCompanion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#1e293b"
                    android:text="Companions"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRepNutrient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#1e293b"
                    android:text="Nutrients"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRepYield"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#1e293b"
                    android:text="Yield"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#020617"
                app:cardCornerRadius="24dp"
                app:strokeColor="#1e293b"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CropNexa"
                        android:textColor="#34d399"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Agricultural Decision Support System"
                        android:textColor="#6ee7b7"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                        
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1e293b"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="REPORT TITLE"
                        android:textColor="#e2e8f0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/llReportContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <Button
            android:id="@+id/btnDownloadReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:backgroundTint="#0ea5e9"
            android:text="Download CSV Report"
            android:textColor="#ffffff" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
