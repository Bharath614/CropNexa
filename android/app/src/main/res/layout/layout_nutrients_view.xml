<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#111625"
    app:cardCornerRadius="16dp"
    app:strokeColor="#1e293b"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/tvNutrientHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nutrient Protocol Engine for Sunflower"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode of Practice: "
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvNutrientHeaderMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Integrated (INM)"
                        android:textColor="#34d399"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNutrientSoilBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soil Report Active ✓"
                android:textColor="#34d399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="#022c22"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <!-- NPK Protocol Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:backgroundTint="#020617"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NPK Protocol Summary:"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/tvNutrientSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INM Soil Test Based for Sunflower: 75% NPK (233 N) + 25% Organic Substitution"
                android:textColor="#34d399"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Grid for Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="#020617"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Basal Dosing Application"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvNutrientBasal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• FYM @ 10 t/ha + 75% recommended synthetic NPK"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="#020617"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bio-Fertilizer Inoculants"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvNutrientBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Azotobacter / PSB bio-inoculants @ 2 kg/ha"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="#020617"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Micronutrients &amp; Bio-Stimulants"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvNutrientMicro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Foliar Zinc Sulphate (0.2%) + Humic Acid @ 3 kg/ha"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="#020617"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phenophase Split Schedule"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvNutrientSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Drip fertigation splits: 50% pre-blooming, 50% post fruit set"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
