<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_emoji_placeholder"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvAvoidName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Crop Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvAvoidConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#4c0519"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="High Confidence"
            android:textColor="#fda4af"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAvoidReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reason goes here"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />
</LinearLayout>
