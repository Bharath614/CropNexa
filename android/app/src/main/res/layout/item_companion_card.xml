<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#111625"
    app:cardCornerRadius="16dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Emoji Box -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_emoji_placeholder">
            <TextView
                android:id="@+id/tvCompanionEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🌱"
                android:textSize="24sp" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCompanionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Name"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCompanionConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#022c22"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Excellent"
                    android:textColor="#34d399"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCompanionTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="#064e3b"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Tag"
                    android:textColor="#10b981"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCompanionMechanism"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mechanism goes here"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCompanionSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Source: Unknown"
                android:textColor="#64748b"
                android:textSize="10sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Add Button -->
        <Button
            android:id="@+id/btnAddCompanion"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#064e3b"
            android:text="Add"
            android:textColor="#ffffff"
            android:textSize="12sp"
            app:cornerRadius="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
