<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#020617"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Farmer Settings"
            app:titleTextColor="#f8fafc"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Personal Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. PERSONAL INFORMATION"
                android:textColor="#34d399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Farmer Name"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFarmerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mobile Number"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Residential Address"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Farm Specs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. FARM &amp; LAND SPECIFICATION"
                android:textColor="#34d399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Farm Name"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFarmName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="GPS Location"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Village"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVillage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="District"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="State"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Total Land (Ha)"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotalLand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Irrigated (Ha)"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIrrigated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Rainfed (Ha)"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRainfed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Soil Type"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSoilType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Previous Crop"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPreviousCrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Current Crop"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a"
                    android:layout_marginEnd="4dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCurrentCrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Planned Crop"
                    android:textColorHint="#94a3b8"
                    app:boxBackgroundColor="#0f172a">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPlannedCrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#f8fafc" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Farming Practice"
                android:textColorHint="#94a3b8"
                app:boxBackgroundColor="#0f172a"
                app:hintTextColor="#34d399"
                android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFarmingPractice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f8fafc" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#0ea5e9"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Save Profile &amp; Preferences"
                android:textColor="#ffffff" />
                
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:backgroundTint="#ef4444"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Log Out"
                android:textColor="#ffffff" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
